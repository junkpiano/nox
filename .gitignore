node_modules
dist
.vite
*.local
.DS_Store
.tmp

# Signing keys. gen/android/.gitignore already covers keystore.properties, but
# a keystore dropped anywhere else in the tree must never be committed: losing
# it or leaking it both end the ability to ship updates safely.
*.jks
*.keystore
keystore.properties
key.properties

# Design and spec documents from the brainstorming workflow. Written to think
# with, not to keep: the decisions that survive belong in docs/ or in the
# comment next to the code they explain.
docs/superpowers/

# Wrangler's local state. cache/wrangler-account.json carries the Cloudflare
# account id, and the tmp/ and state/ trees are build scratch, not source.
.wrangler/
