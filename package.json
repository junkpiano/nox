{
  "name": "nox",
  "version": "1.0.0",
  "description": "nox relay-first client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "rm -rf .tmp/test-dist && tsc -p tsconfig.test.json && node --experimental-sqlite --test .tmp/test-dist/tests/*.test.js",
    "test:coverage": "rm -rf .tmp/test-dist && tsc -p tsconfig.test.json --sourceMap && node --experimental-sqlite --enable-source-maps --test --experimental-test-coverage .tmp/test-dist/tests/*.test.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "baseline-browser-mapping": "^2.11.35",
    "caniuse-lite": "^1.0.30001823",
    "emoji-dictionary": "^1.0.12",
    "nostr-tools": "^2.26.0",
    "qrcode": "^1.5.4",
    "rx-nostr": "^3.7.8",
    "rxjs": "^7.8.2"
  }
}
