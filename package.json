{
  "name": "nox",
  "version": "1.0.0",
  "description": "nox relay-first client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "tsc -p tsconfig.test.json && node --test .tmp/test-dist/tests/*.test.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:bundle": "tauri android build --aab"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.0.9",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "baseline-browser-mapping": "^2.10.42",
    "caniuse-lite": "^1.0.30001802",
    "emoji-dictionary": "^1.0.12",
    "nostr-tools": "^2.23.0",
    "qrcode": "^1.5.4",
    "rx-nostr": "^3.6.2",
    "rxjs": "^7.8.2"
  }
}
