{
  "expo": {
    "name": "nox",
    "slug": "nox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "garden.nox",
      "associatedDomains": ["applinks:nox.garden"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "garden.nox",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "nox.garden", "pathPrefix": "/npub1" },
            { "scheme": "https", "host": "nox.garden", "pathPrefix": "/nprofile1" },
            { "scheme": "https", "host": "nox.garden", "pathPrefix": "/note1" },
            { "scheme": "https", "host": "nox.garden", "pathPrefix": "/nevent1" },
            { "scheme": "https", "host": "nox.garden", "pathPrefix": "/t/" },
            { "scheme": "https", "host": "nox.garden", "pathPattern": "/.*@.*" },
            { "scheme": "https", "host": "nox.garden", "path": "/global" },
            { "scheme": "https", "host": "nox.garden", "path": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": ["nox", "nostr", "web+nostr"],
    "plugins": ["expo-status-bar", "expo-secure-store", "expo-sqlite"]
  }
}
